# ============================================================
# Upwork AI Assistant — конфигурация
# Скопируйте этот файл в .env и заполните значения.
# Структура .env и .env.example должна совпадать: отличаются только значения.
# ============================================================

# --- Upwork ---
# Логин и пароль аккаунта. Нужны только для разового ассистированного входа:
#   python -m upwork_assistant.tools.login
UPWORK_EMAIL=
UPWORK_PASSWORD=
# URL сохранённого поиска. Несколько адресов разделяются символом ";"
UPWORK_SEARCH_URLS=https://www.upwork.com/nx/search/jobs/?q=python&sort=recency
# Каталог persistent-профиля браузера: хранит сессию и clearance-куку Cloudflare
UPWORK_PROFILE_DIR=data/browser_profile
# Запуск браузера без окна. На проверке 2026-09-07 headless=True словил
# челлендж Cloudflare даже с валидным залогиненным профилем — headful нет.
# Пока не найден обход, держите False; на сервере это значит нужен
# виртуальный дисплей (Xvfb) для headful-запуска в контейнере/без монитора.
UPWORK_HEADLESS=False
# HTTP(S)-прокси для браузера, если Cloudflare блокирует IP. Пусто — без прокси
UPWORK_PROXY=
# Сколько страниц поиска (по 10 вакансий) листать за цикл на каждый URL
UPWORK_MAX_PAGES_PER_SEARCH=3

# --- OpenRouter (LLM) ---
# Ключ создаётся на https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Дешёвая модель — вызывается для каждой вакансии
OPENROUTER_SCORING_MODEL=openai/gpt-5-mini
# Сильная модель — вызывается только для прошедших порог
OPENROUTER_PROPOSAL_MODEL=openai/gpt-5
# Дневной потолок расходов на LLM в USD; при превышении генерация останавливается
OPENROUTER_DAILY_BUDGET_USD=2.0

# --- Telegram ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш числовой id от @userinfobot
TELEGRAM_USER_ID=

# --- Профиль фрилансера ---
# Markdown с вашим опытом, стеком и тоном; подмешивается в промпт генерации отклика
FREELANCER_PROFILE_PATH=data/profile.md

# --- Фильтры ---
# Порог релевантности 0-10, ниже которого уведомление не отправляется
MIN_SCORE_TO_NOTIFY=7.0

# --- Планировщик ---
POLL_INTERVAL_MINUTES=10
POLL_JITTER_PCT=40
MAX_PAGE_LOADS_PER_HOUR=20

# --- База данных ---
DATABASE_URL=sqlite+aiosqlite:///data/upwork_assistant.db

# --- Логирование ---
LOG_LEVEL=INFO
LOG_FILE=logs/assistant.log
LOG_JSON=False

# --- HTTP-сервер ---
API_HOST=0.0.0.0
API_PORT=8077
